  - m_Id: 157466685440
    m_Localized: Control - Keyboard
    m_Metadata:
      m_Items: []
  - m_Id: 245274439680
    m_Localized: '<sprite name="ui_controls_W"><sprite name="ui_controls_A"><sprite
      name="ui_controls_S"><sprite name="ui_controls_D"> - Tilt Stage

      <sprite
      name="ui_controls_space"> - Push other enemy

      <sprite name="ui_controls_shift">
      - Boost stage tilt(more degrees to tilt)'
    m_Metadata:
      m_Items: []
  - m_Id: 339302346752
    m_Localized: '<sprite name="ui_controls_pad_L"> - Tilt Stage

      <sprite name="ui_controls_pad_X">
      - Push other enemy

      <sprite name="ui_controls_pad_A"> - Boost stage tilt(more
      degrees to tilt)'
    m_Metadata:
