    m_Metadata:
      m_Items: []
  - m_Id: 853872144384
    m_Localized: "\uC0AC\uC6A9\uC790 \uB370\uC774\uD130"
    m_Metadata:
      m_Items: []
  - m_Id: 936231497728
    m_Localized: "\uC9C4\uD589"
    m_Metadata:
      m_Items: []
  - m_Id: 898596007936
    m_Localized: "\uC774 \uAE30\uAE30\uC758 \uBAA8\uB4E0 \uD50C\uB808\uC774 \uAE30\uB85D
      \uCD08\uAE30\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 954220867584
    m_Localized: "\uC815\uBCF4"
    m_Metadata:
      m_Items: []
  - m_Id: 994024812544
    m_Localized: "Copyrights to Urbanmaid\n\uC544\uD2B8 \uC5D0\uC14B\uC744 \uC81C\uC678\uD55C
      \uC774 \uC18C\uD504\uD2B8\uC6E8\uC5B4\uC758 \uC8FC\uC694 \uAD6C\uC870 \uCF54\uB4DC\uB294
      \uC0DD\uC131\uD615 AI\uB97C \uC0AC\uC6A9\uD574 \uC81C\uC791\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\n\uC791\uC131\uC790\uAC00
      \uC9C1\uC811 \uC0DD\uC131\uD558\uAC70\uB098 \uC81C\uC791\uD558\uC9C0 \uC54A\uC740
      \uC5D0\uC14B\uC758 \uC81C\uC791\uC790 \uC815\uBCF4\uB294 \uC544\uB798 \uB0B4\uC6A9\uC744
      \uD655\uC778\uD574 \uC8FC\uC138\uC694. "
    m_Metadata:
      m_Items: []
  - m_Id: 1028803981312
    m_Localized: "\uC774 \uD504\uB85C\uC81D\uD2B8\uC758 \uC800\uC7A5\uC18C \uBC29\uBB38"
    m_Metadata:
      m_Items: []
  - m_Id: 2101639835648
    m_Localized: "\uC0DD\uC874 \uC2DC\uAC04"
    m_Metadata:
      m_Items: []
  - m_Id: 2420104949760
    m_Localized: "\uC810\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 2555459334144
    m_Localized: "\uB808\uBCA8 {0} \uC5C5\uADF8\uB808\uC774\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 2654553960448
    m_Localized: "\uACC4\uC18D\uD558\uB824\uBA74 \uC5C5\uADF8\uB808\uC774\uB4DC \uD558\uB098\uB97C
      \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3295703658496
    m_Localized: "\uCCB4\uB825 \uC544\uC774\uD15C \uBC00\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 3599190913024
    m_Localized: "\uCCB4\uB825 \uC544\uC774\uD15C\uC774 \uB354 \uBE60\uB974\uAC8C
      \uC0DD\uC131\uB418\uACE0 \uCD5C\uB300 \uAC1C\uC218\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4."
